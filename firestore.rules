rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in person can read and write only their own settings and images.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /images/{key} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
